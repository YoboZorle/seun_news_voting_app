# Podfile
# NAIJANEWS v4.0 - Updated for iOS 14.0+ with Notification Support

platform :ios, '14.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Project configuration for different build types
project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

# NAIJANEWS Target Configuration
target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Install all Flutter iOS pods
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  # NOTIFICATION SPECIFIC PODS
  # These are installed via Flutter but we can add additional ones here if needed

  # Optional: For rich notifications (images, video, etc.)
  # pod 'SDWebImage'

  # Optional: For advanced notification handling
  # pod 'Firebase/Messaging' # If using Firebase Cloud Messaging

  # Test target configuration
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Post-install hook configuration
post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # Configure build settings for all targets
    target.build_configurations.each do |config|
      # Set minimum iOS deployment target
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '14.0'

      # Configure preprocessor definitions for permissions and features
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        # Notification Permissions
        'PERMISSION_NOTIFICATIONS=1',
        # Location Permission (for future location-based notifications)
        'PERMISSION_LOCATION=1',
        # Microphone Permission (for future audio features)
        'PERMISSION_MICROPHONE=1',
      ]

      # NOTIFICATION SPECIFIC CONFIGURATIONS
      # Enable critical alerts capability
      if config.name == 'Release' || config.name == 'Profile'
        config.build_settings['ENABLE_BITCODE'] = 'NO'
      end

      # Ensure proper linking for notification frameworks
      config.build_settings['OTHER_LDFLAGS'] ||= ['$(inherited)']
      config.build_settings['OTHER_LDFLAGS'] << '-framework UserNotifications'

      # Set up Swift version compatibility (iOS 14+ uses Swift 5.3+)
      config.build_settings['SWIFT_VERSION'] = '5.3'
    end
  end
end

